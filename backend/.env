APP_NAME=Tably API
ENV=development

# Local free dev (default): sqlite:///./tablereserve.db
# Production (Supabase Postgres): postgresql://postgres:<password>@<project>.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./tablereserve.db

JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
