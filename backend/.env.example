APP_NAME=TableReserve API
ENV=development

# Local free dev (default): sqlite:///./tablereserve.db
# Production (Supabase Postgres pooler - required for Render/other external hosts,
# see RUN_INSTRUCTIONS.md): postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./tablereserve.db

JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional - free API key from https://www.pexels.com/api/ (no credit card).
# Used only by scripts/seed_data.py and scripts/backfill_images.py to pull
# real restaurant photos instead of generated placeholder graphics.
# Leave blank and the app works fully, just with generated graphics instead.
PEXELS_API_KEY=
